DATABASE_URL=postgres://user:password@localhost:5432/au_service_requests
PGSSL=false
JWT_SECRET=replace-with-a-long-random-string
PORT=4000

# Used to build the password-reset link that gets emailed/logged (see
# forgot-password below). Should be the frontend's public URL.
FRONTEND_URL=http://localhost:5173

# No email provider is wired up yet — forgot-password reset links are
# logged to the server console instead of emailed. Once you pick a
# provider (SendGrid, Mailgun, SMTP, etc.), send the link built in
# POST /api/auth/forgot-password instead of console.log-ing it.
